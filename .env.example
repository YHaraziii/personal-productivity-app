# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API). Both values are designed to be public:
# they identify the project, and all data is protected by Row Level Security.
#
# NEVER put the service_role key (or any other secret) in this file or in any
# VITE_* variable: everything prefixed with VITE_ is embedded in the browser bundle.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
